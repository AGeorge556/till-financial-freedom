      "checkConstraints": {
        "transactions_amount_check": {
          "name": "transactions_amount_check",
          "value": "\"transactions\".\"amount\" <> 0 and (\"transactions\".\"type\" = 'ADJUSTMENT' or \"transactions\".\"amount\" > 0)"
        },
        "transactions_accounts_by_type_check": {
          "name": "transactions_accounts_by_type_check",
          "value": "(\n        \"transactions\".\"type\" in ('INCOME', 'DIVIDEND', 'INTEREST', 'INVESTMENT_SALE', 'ADJUSTMENT')\n          and \"transactions\".\"to_account_id\" is not null and \"transactions\".\"from_account_id\" is null\n      ) or (\n        \"transactions\".\"type\" in ('EXPENSE', 'INVESTMENT_PURCHASE', 'LIABILITY_PAYMENT')\n          and \"transactions\".\"from_account_id\" is not null and \"transactions\".\"to_account_id\" is null\n      ) or (\n        \"transactions\".\"type\" = 'TRANSFER'\n          and \"transactions\".\"from_account_id\" is not null and \"transactions\".\"to_account_id\" is not null\n          and \"transactions\".\"from_account_id\" <> \"transactions\".\"to_account_id\"\n      )"
        }
      },
