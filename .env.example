# Supabase project URL (public).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Supabase anon key (public; RLS protects the data).
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only; never expose to the browser or commit a real value.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Supabase transaction-mode pooler connection string (port 6543); used by the app.
DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-region.pooler.supabase.com:6543/postgres
# Direct connection string; used by drizzle-kit for migrations.
DIRECT_URL=postgresql://postgres:your-db-password@db.your-project-ref.supabase.co:5432/postgres
# auth.users id of the account that "npm run db:seed" fills with starter data.
SEED_USER_ID=00000000-0000-0000-0000-000000000000
# Web push (phase 7). Public half of the VAPID key pair; the Notifications card is hidden unless all three VAPID values are set.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
# Server-only; the private half of the VAPID key pair. Never expose it to the browser.
VAPID_PRIVATE_KEY=your-vapid-private-key
# A mailto: address that push services can reach you on, like mailto:you@example.com.
VAPID_SUBJECT=mailto:you@example.com
# Server-only; a long random string. Vercel Cron sends it as "Authorization: Bearer <value>" and the daily job rejects anything else.
CRON_SECRET=a-long-random-string
